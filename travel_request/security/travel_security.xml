<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_travel_request_personal" model="ir.rule">
            <field name="name">Travel Request: Personal Requests Only</field>
            <field name="model_id" ref="model_travel_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_travel_request_manager_all" model="ir.rule">
            <field name="name">Travel Request: Manager See All</field>
            <field name="model_id" ref="model_travel_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('account.group_account_manager')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>