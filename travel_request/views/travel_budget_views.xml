<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_budget_search" model="ir.ui.view">
        <field name="name">travel.budget.search</field>
        <field name="model">travel.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="name"/>
                <field name="department_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_travel_budget_tree" model="ir.ui.view">
        <field name="name">travel.budget.tree</field>
        <field name="model">travel.budget</field>
        <field name="arch" type="xml">
            <list string="Travel Budgets" decoration-danger="remaining_amount &lt; 0" decoration-warning="remaining_amount &lt; (budget_amount * 0.2)">
                <field name="name"/>
                <field name="department_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="budget_amount" widget="monetary"/>
                <field name="total_spent" widget="monetary"/>
                <field name="remaining_amount" widget="monetary" decoration-bf="1"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_travel_budget_form" model="ir.ui.view">
        <field name="name">travel.budget.form</field>
        <field name="model">travel.budget</field>
        <field name="arch" type="xml">
            <form string="Travel Budget">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Budget Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. IT Dept Budget 2024"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Budget Scope">
                            <field name="department_id"/>
                            <label for="date_start" string="Period"/>
                            <div class="o_row">
                                <field name="date_start" widget="daterange" options="{'related_end_date': 'date_end'}"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="To"/>
                                <field name="date_end" widget="daterange" options="{'related_start_date': 'date_start'}"/>
                            </div>
                            <field name="active" invisible="1"/>
                        </group>
                        
                        <group string="Financials">
                            <field name="budget_amount" widget="monetary"/>
                            <field name="total_spent" widget="monetary" decoration-danger="total_spent &gt; budget_amount"/>
                            <field name="remaining_amount" widget="monetary" decoration-bf="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="action_travel_budget" model="ir.actions.act_window">
        <field name="name">Department Budgets</field>
        <field name="res_model">travel.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_travel_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Department Budget
            </p>
            <p>
                Define budget limits for each department to control travel expenses.
            </p>
        </field>
    </record>
</odoo>